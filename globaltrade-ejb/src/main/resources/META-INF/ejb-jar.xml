<?xml version="1.0" encoding="UTF-8"?>
<ejb-jar xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/ejb-jar_4_0.xsd"
         version="4.0">

    <display-name>GlobalTradeEJBModule</display-name>

    <interceptors>
        <interceptor>
            <interceptor-class>com.globaltrade.interceptor.AuditInterceptor</interceptor-class>
        </interceptor>
        <interceptor>
            <interceptor-class>com.globaltrade.interceptor.PerformanceInterceptor</interceptor-class>
        </interceptor>
        <interceptor>
            <interceptor-class>com.globaltrade.interceptor.SecurityInterceptor</interceptor-class>
        </interceptor>
        <interceptor>
            <interceptor-class>com.globaltrade.interceptor.VendorValidationInterceptor</interceptor-class>
        </interceptor>
        <interceptor>
            <interceptor-class>com.globaltrade.interceptor.ComplianceInterceptor</interceptor-class>
        </interceptor>
    </interceptors>

    <assembly-descriptor>
        <interceptor-binding>
            <ejb-name>OrderServiceBean</ejb-name>
            <interceptor-class>com.globaltrade.interceptor.AuditInterceptor</interceptor-class>
        </interceptor-binding>
        <interceptor-binding>
            <ejb-name>OrderServiceBean</ejb-name>
            <interceptor-class>com.globaltrade.interceptor.PerformanceInterceptor</interceptor-class>
        </interceptor-binding>
    </assembly-descriptor>
</ejb-jar>
